---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const description =
	'商談会準備専門店は、初めて商談会に出る食品メーカー・IT企業のために、成果が出るブースの型を貸し出すサービスです。';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`このサイトについて | ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div class="hero-in">
					<h1>このサイトについて</h1>
					<p class="sub">
						商談会準備専門店は、初めて商談会に出る食品メーカー・IT企業のために、
						成果が出るブースの型を貸し出すサービスです。
					</p>
					<div class="meta">運営：MARE</div>
				</div>
			</div>

			<div class="block">
				<div class="block-in">
					<div class="bhead">
						<div class="blabel">01　はじめた理由</div>
						<div class="btitle">準備の差が、<br />成果の差になっている</div>
					</div>
					<div class="bbody">
						<p class="pull">商談会は、出る前に決まっている部分が大きい。</p>
						<div class="btext">
							<p>
								商談会や展示会の現場では、同じ出展料を払っているのに、成果に大きな差が出ます。商品の力の差ではありません。差がつくのは、当日までの準備です。
							</p>
							<p>
								何度も出ている企業は、設営の順番も、商品の置き方も、当日の動き方も分かっています。初めての企業には、それを知る機会がありません。搬入日の朝、会場で他社のブースを見て初めて気づき、そのときにはもう直せません。
							</p>
							<p>
								この差を埋めるために、経験のある担当者が頭の中に持っているものを、誰でも使える形にしました。
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="block">
				<div class="block-in">
					<div class="bhead">
						<div class="blabel">02　やっていること</div>
						<div class="btitle">情報ではなく、<br />道具にして届ける</div>
					</div>
					<div class="bbody">
						<div class="btext">
							<p>
								展示会のノウハウを解説した記事も、セミナーも、世の中にはすでにあります。しかし読んだあとで「では、うちの商品はどこに置けばいいのか」までは分かりません。情報だけでは、行動につながらないからです。
							</p>
							<p>かといって、備品だけを借りても成果は出ません。ライトを借りても、木箱を置いても、それだけでは何も変わらない。</p>
							<p>
								だから、知識を道具に落とし込みます。ひな壇には商品の並べ方が刻まれ、ライトの裏面には食品ごとの照射位置が書かれ、箱を開ける順番がそのまま設営の順番になっている。読まなくても、順番になぞるだけで形になる状態を目指しています。
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="block">
				<div class="block-in">
					<div class="bhead">
						<div class="blabel">03　やらないこと</div>
						<div class="btitle">展示会コンサルには<br />なりません</div>
					</div>
					<div class="bbody">
						<div class="btext">
							<p>
								ブース設計の相談に乗ることも、レイアウトの提案書を作ることも、このサービスの仕事ではありません。目指しているのは、説明しなくても成果が出る道具をつくることです。
							</p>
							<p>
								また、完成したブースを丸ごと売ることもしません。同じ型を使っても、商品も伝えたいことも会社ごとに違うからです。ベースだけをお貸しして、その上は出展者ご自身に組み立てていただきます。
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="block">
				<div class="block-in">
					<div class="bhead">
						<div class="blabel">04　運営</div>
						<div class="btitle">運営者について</div>
					</div>
					<div class="bbody">
						<div class="btext">
							<p>
								屋号「MARE」として、個人で運営しています。食品の製造・流通の現場に近い場所で、商談会や展示会の準備に長く関わってきました。
							</p>
							<p>現在はサービスの立ち上げ段階にあり、実際にご利用いただいた出展者の方の声をもとに、備品と設営設計を改良している最中です。</p>
							<p>お問い合わせ窓口は準備中です。</p>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
