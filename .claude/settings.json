{
  "permissions": {
    "deny": [
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__send_email",
      "mcp__claude_ai_Gmail__send_draft",
      "mcp__claude_ai_Gmail__send",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__forward_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__reply_all",
      "mcp__claude_ai_Gmail__delete_message",
      "mcp__claude_ai_Gmail__delete_thread",
      "mcp__claude_ai_Gmail__delete_draft",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__create_filter"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Gg]mail.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gmail-guard.mjs\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*[Gg]mail.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gmail-guard.mjs\" post"
          }
        ]
      }
    ]
  }
}
